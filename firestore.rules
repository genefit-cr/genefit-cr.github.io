rules_version = '2';

// Reglas de seguridad de Genefit.
// Se publican en la consola de Firebase: Firestore Database → Reglas → pegar → Publicar.
//
// Idea general:
//  - Cada cliente solo ve y escribe lo suyo.
//  - El coach (la cuenta guardada en config/coach) ve a todos sus clientes,
//    pero NUNCA ve la carpeta "privado" de nadie (medidas y fotos no compartidas).
//  - Nadie más puede leer nada. Todo lo que no está aquí queda prohibido.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas ----------
    function dentro() { return request.auth != null; }
    function soy(uid) { return dentro() && request.auth.uid == uid; }
    function rutaCoach() { return /databases/$(database)/documents/config/coach; }
    function esCoach() {
      return dentro() && exists(rutaCoach()) && get(rutaCoach()).data.uid == request.auth.uid;
    }
    function rutaAcceso(uid) { return /databases/$(database)/documents/acceso/$(uid); }
    // Cliente eliminado por el coach: ya no puede escribir nada en su ficha.
    function eliminado(uid) {
      return exists(rutaAcceso(uid)) && get(rutaAcceso(uid)).data.get('eliminado', false) == true;
    }
    function texto(v, max) { return v is string && v.size() <= max; }
    function numero(v) { return v is number && v >= 0; }
    function datos() { return request.resource.data; }
    function cambia() { return datos().diff(resource.data).affectedKeys(); }

    // ---------- Quién es el coach ----------
    match /config/coach {
      allow read: if dentro();
      // Solo se puede reclamar una vez, y solo para uno mismo.
      allow create: if dentro() && datos().uid == request.auth.uid
        && datos().keys().hasOnly(['uid', 'nombre']) && texto(datos().nombre, 40);
      // El coach también guarda aquí sus datos de cobro por SINPE Móvil (los ven sus clientes para pagarle).
      allow update: if esCoach() && datos().keys().hasOnly(['uid', 'nombre', 'sinpe', 'monto', 'titular', 'ntfy'])
        && datos().uid is string && texto(datos().nombre, 40)
        && texto(datos().get('sinpe', ''), 12) && texto(datos().get('titular', ''), 60) && texto(datos().get('ntfy', ''), 64)
        && (!('monto' in datos()) || numero(datos().monto));
      allow delete: if false;
    }

    // ---------- Mensualidades y acceso (solo las cambia el coach) ----------
    match /acceso/{uid} {
      allow read: if soy(uid) || esCoach();
      allow write: if esCoach();
    }

    // ---------- Rutinas plantilla del coach ----------
    match /plantillas/{id} {
      allow read, write: if esCoach();
    }

    // ---------- Traducciones de técnica de ejercicios ----------
    match /trad/{id} {
      allow read: if dentro();
      allow write: if esCoach();
    }

    // ---------- Ficha de cada cliente (lo que su coach puede ver) ----------
    match /clientes/{uid} {
      function camposCliente() {
        return ['alias', 'alta', 'compartir', 'v', 'ultimo', 'ultTitulo', 'ultMin', 'ultPRs', 'ultVol', 'ultMsg', 'sexo', 'tend', 'compPend', 'dolor'];
      }
      function sexoValido() { return !('sexo' in datos()) || datos().sexo in ['m', 'f']; }
      // El último mensaje solo lo puede poner quien lo escribió (si no cambia, no se revisa).
      function ultMsgValido() {
        return !('ultMsg' in datos())
          || (resource != null && resource.data.get('ultMsg', null) == datos().ultMsg)
          || (datos().ultMsg.de == request.auth.uid && texto(datos().ultMsg.texto, 500));
      }
      allow read: if soy(uid) || esCoach();
      allow create: if soy(uid) && !eliminado(uid)
        && datos().keys().hasOnly(camposCliente()) && texto(datos().alias, 40) && ultMsgValido() && sexoValido();
      // Solo se revisan los campos que cambian, para no trabar fichas antiguas con campos viejos.
      allow update: if (soy(uid) && !eliminado(uid)
          && cambia().hasOnly(camposCliente()) && texto(datos().get('alias', ''), 40) && ultMsgValido() && sexoValido())
        || (esCoach() && cambia().hasOnly(['ultMsg', 'compPend']) && ultMsgValido());
      allow delete: if esCoach();

      // Entrenos y récords: los escribe el cliente, los lee también el coach.
      match /historial/{id} {
        allow read: if soy(uid) || esCoach();
        allow create, update: if soy(uid) && !eliminado(uid)
          && texto(datos().get('titulo', ''), 80) && texto(datos().get('nota', ''), 300);
        allow delete: if soy(uid) || esCoach();
      }
      match /records/{id} {
        allow read: if soy(uid) || esCoach();
        allow create, update: if soy(uid) && !eliminado(uid) && texto(datos().nombre, 120);
        allow delete: if soy(uid) || esCoach();
      }

      // Copias de medidas y fotos: solo existen si el cliente activó "compartir".
      match /medidas/{id} {
        allow read: if soy(uid) || esCoach();
        allow create, update: if soy(uid) && !eliminado(uid) && numero(datos().fecha);
        allow delete: if soy(uid) || esCoach();
      }
      match /fotos/{id} {
        allow read: if soy(uid) || esCoach();
        allow create, update: if soy(uid) && !eliminado(uid)
          && datos().img is string && datos().img.matches('^data:image/(jpeg|png|webp);base64,.*')
          && datos().img.size() < 900000;
        allow delete: if soy(uid) || esCoach();
      }

      // Rutinas asignadas: solo el coach las pone o las quita.
      match /asignadas/{id} {
        allow read: if soy(uid) || esCoach();
        allow write: if esCoach();
      }

      // Comprobantes de pago por SINPE: el cliente los sube (aunque su mensualidad esté vencida),
      // solo el coach los aprueba o rechaza.
      match /comprobantes/{id} {
        allow read: if soy(uid) || esCoach();
        allow create: if soy(uid) && !eliminado(uid) && datos().estado == 'pendiente'
          && datos().keys().hasOnly(['img', 'ref', 'monto', 'fecha', 'estado'])
          && datos().img is string && datos().img.matches('^data:image/(jpeg|png|webp);base64,.*')
          && datos().img.size() < 900000 && texto(datos().ref, 40) && numero(datos().monto) && numero(datos().fecha);
        allow update: if esCoach() && cambia().hasOnly(['estado', 'revisado'])
          && datos().estado in ['aprobado', 'rechazado'];
        allow delete: if esCoach();
      }

      // Chat cliente ↔ coach. Nadie puede escribir a nombre de otro ni editar mensajes.
      match /mensajes/{id} {
        allow read: if soy(uid) || esCoach();
        allow create: if ((soy(uid) && !eliminado(uid)) || esCoach())
          && datos().de == request.auth.uid && texto(datos().texto, 500) && numero(datos().fecha);
        allow update: if false;
        allow delete: if esCoach();
      }
    }

    // ---------- Retos del gimnasio ----------
    // El coach los crea. Cada cliente decide si se une; en el ranking solo va su nombre y su número.
    match /retos/{id} {
      allow read: if dentro();
      allow write: if esCoach();
      match /participantes/{p} {
        allow read: if dentro();
        allow create, update: if soy(p) && !eliminado(p) && exists(/databases/$(database)/documents/retos/$(id))
          && datos().keys().hasOnly(['alias', 'valor', 'act']) && texto(datos().alias, 40)
          && numero(datos().valor) && numero(datos().act);
        allow delete: if soy(p) || esCoach();
      }
    }

    // ---------- Carpeta privada: SOLO su dueño, ni siquiera el coach ----------
    match /privado/{uid}/{resto=**} {
      allow read, write: if soy(uid);
    }
  }
}
